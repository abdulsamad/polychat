{
  "name": "serverless",
  "private": true,
  "scripts": {
    "dev": "pnpm run sam:local",
    "sam:local": "pnpm run build && sam local start-api --template template.local.yaml --env-vars .env --port 3001 --warm-containers eager",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:@aws-sdk/*",
    "deploy": "pnpm run build && sam deploy && rm -rf dist/*"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/deepseek": "^3.0.28",
    "@ai-sdk/fal": "^3.0.28",
    "@ai-sdk/google": "^4.0.45",
    "@ai-sdk/mistral": "^4.0.29",
    "@ai-sdk/openai": "^4.0.42",
    "@hono/node-server": "^1.17.1",
    "ai": "^7.0.67",
    "hono": "^4.8.9",
    "jose": "^5.10.0",
    "utils": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "esbuild": "^0.25.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  }
}
