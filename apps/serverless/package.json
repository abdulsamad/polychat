{
  "name": "serverless",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:test",
    "dev:test": "pnpm run build && node --env-file=.env.test dist/local.js",
    "sam:local": "pnpm run build && sam local start-api --template template.local.yaml --env-vars env.test.json --port 3001 --warm-containers eager",
    "build": "esbuild src/index.ts src/local.ts --bundle --platform=node --target=node22 --outdir=dist \"--external:@aws-sdk/*\"",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/deepseek": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/mistral": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@hono/node-server": "^1.19.17",
    "ai": "catalog:",
    "hono": "^4.13.5",
    "jose": "^5.10.0",
    "utils": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  }
}
