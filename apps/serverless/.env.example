PORT=3001
ALLOWED_ORIGINS=* # Comma-separated allowed browser origins for the deployed Lambda URL
CLERK_ISSUER_BASE_URL= # Cleark issuer base URL
CLERK_AUTHORIZED_PARTIES=http://localhost:3000 # Comma-separated Clerk token origins
LAMBDA_PROXY_SECRET= # Random secret shared only by Cloudflare Pages and Lambda

GEMINI_API_KEY= # Gemini API key
OPENAI_API_KEY= # Open AI API key
ANTHROPIC_API_KEY= # Anthropic API key
MISTRAL_API_KEY= # Mistral API key
DEEPSEEK_API_KEY= # DeekSeek API key
OPENROUTER_API_KEY= # OpenRouter API key
