{
  "name": "polychat",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSE",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "kill-ports": "kill-port 3000 3001",
    "client:dev": "pnpm --filter=client run dev",
    "client:dev:test": "pnpm --filter=client run dev:test",
    "serverless:sam": "pnpm --filter=serverless run sam:local",
    "client:build": "turbo run build --filter=client",
    "serverless:dev": "pnpm --filter=serverless run dev",
    "serverless:dev:test": "pnpm --filter=serverless run dev:test",
    "dev:local": "pnpm --parallel --filter client --filter serverless run dev:test",
    "serverless:build": "turbo run build --filter=serverless",
    "serverless:deploy": "pnpm --filter=serverless run deploy"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
